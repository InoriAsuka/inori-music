<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SECURITY TRADE-OFF (v5.36.0) — android:usesCleartextTraffic below
         deliberately downgrades Android's default posture; keep this
         reasoning attached to the switch, not scattered elsewhere.
         The self-hosted server has no HTTPS in front of it (LAN-only
         deployment) and its address is entered by the user at runtime
         (Settings > Server), so there is no fixed domain known at build
         time to scope a network security config allowlist to — it's this
         single attribute or nothing. Without it, just_audio's Android
         backend (a real ExoPlayer instance, unlike dio's dart:io-based
         HTTP calls) refuses to open the http:// stream and playback fails;
         ExoPlayer's own internal localhost proxy for header/caching support
         needs cleartext too, independent of the remote scheme.
         Revert condition: once the server is reachable over HTTPS, delete
         this one attribute — Android's post-P default (cleartext traffic
         blocked) already covers it, no other file needs to change. -->
    <application
        android:label="inori_music"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep link: inori:// custom scheme (all paths) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inori" />
            </intent-filter>

            <!-- Deep link: inori://tracks, inori://albums, inori://artists -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inori" android:host="tracks" />
                <data android:scheme="inori" android:host="albums" />
                <data android:scheme="inori" android:host="artists" />
            </intent-filter>
        </activity>

        <!-- audio_service background playback service -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- audio_service media button receiver -->
        <receiver android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required to reach the self-hosted server at all: API calls (dio) and
         audio streaming (just_audio) both need it (v5.36.0). The debug and
         profile manifests already declare this, but only for the Flutter
         tool's own use (hot reload, DevTools) — that grant is stripped out
         of release builds along with the rest of those overlays, so without
         a copy here a release APK has no network access whatsoever. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for media controls via bluetooth / headset buttons and foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
